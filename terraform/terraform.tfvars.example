# AWS Configuration
aws_region       = "us-east-1"
instance_type    = "t2.micro"
key_name         = "sentra-key"    # Create this in AWS Console first
allowed_ssh_cidr = "0.0.0.0/0"     # Restrict to your IP for security: "YOUR.IP.ADDRESS/32"

# API Keys (get these from respective platforms)
youtube_api_key      = ""
bluesky_handle       = ""
bluesky_app_password = ""
reddit_client_id     = ""
reddit_client_secret = ""

# Database
postgres_password = "your_secure_password_here"
